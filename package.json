{
    "name": "py-cond-to-cpp",
    "displayName": "If/While Fixer",
    "description": "Converts a Python syntax if/while condition into C++",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.138.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "py-cond-to-cpp.convert",
                "title": "Convert Python-style if/while to C++"
            }
        ],
        "keybindings": [
            {
                "command": "py-cond-to-cpp.convert",
                "key": "alt+enter",
                "when": "editorTextFocus && editorLangId =~ /^(c|cpp)$/"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "test": "vscode-test",
        "test:unit": "mocha -r ts-node/register --ui tdd src/test/convertCondition.test.ts",
        "test:unit_v": "mocha -r ts-node/register --ui tdd src/test/convertCondition.test.ts 2>&1 | tee /tmp/mocha-out.log; echo; echo '--- Summary ---'; grep -E '(passing|failing)' /tmp/mocha-out.log"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "24.x",
        "@types/vscode": "^1.138.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.0.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.5.0",
        "mocha": "^12.0.2",
        "npm-run-all": "^4.1.5",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1"
    },
    "overrides": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.6"
    }
}
